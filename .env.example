# Convex deploy key from the Convex dashboard (Settings → Deploy keys).
# Only needed to deploy; `npx convex dev` manages local development itself.
CONVEX_DEPLOY_KEY=

# Set in your hosting provider so the built app knows where to sync.
# Locally this is written to .env.local by `npx convex dev`.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
